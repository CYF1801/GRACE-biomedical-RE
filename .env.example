# ===== LLM / Embedding (Alibaba DashScope) =====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# ===== NCBI E-utilities (free, optional key raises rate limit) =====
NCBI_API_KEY=
NCBI_EMAIL=your-email@example.com

# ===== Proxy (optional) =====
HTTP_PROXY=
HTTPS_PROXY=

